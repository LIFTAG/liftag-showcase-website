# Copy this file to .env in this directory, then fill in the Maps values.
# Restart the development server after changing environment variables.

# Public LIFTAG API. Override to use a staging or local API.
NUXT_PUBLIC_API_BASE_URL=https://api.liftag.fit

# Required for the Explore map. Restrict the API key to allowed website referrers.
# Enable the Maps JavaScript API. Advanced markers also require a Google map ID.
# For local testing, use DEMO_MAP_ID; use your own map ID in production.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NUXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional search-engine ownership verification.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=
